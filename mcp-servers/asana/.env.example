# Required: Asana Personal Access Token. Create at:
#   https://app.asana.com/0/my-apps
ASANA_PAT=

# Required: Asana project GID (numeric string).
# Find at: project URL https://app.asana.com/0/<PROJECT_GID>/list
MDOPS_ASANA_PROJECT=

# Optional: workspace GID. If unset, the server resolves it from the project.
MDOPS_ASANA_WORKSPACE=

# Optional: comma-separated tags applied to every task created via mdops_create_issue.
# Default "markdownops". Tags are auto-created in the workspace if missing.
MDOPS_DEFAULT_LABELS=markdownops

# Optional: base URL where Markdown artifacts live, used by mdops_link_artifact.
MDOPS_ASANA_ARTIFACT_BASE=

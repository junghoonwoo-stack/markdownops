# Required: a GitLab personal access token with the "api" scope.
# Create at: <gitlab-host>/-/user_settings/personal_access_tokens
GITLAB_TOKEN=

# Required: target project. Either:
#   - Numeric project ID, e.g. "12345678"
#   - URL path, e.g. "namespace/repo" or "group/subgroup/repo" (will be URL-encoded)
MDOPS_GITLAB_PROJECT=

# Optional: GitLab host. Default https://gitlab.com.
# For self-hosted GitLab, set to your instance, e.g. https://gitlab.example.com
MDOPS_GITLAB_HOST=https://gitlab.com

# Optional: default labels added to every issue created by mdops_create_issue.
# Comma-separated. Leave empty to add no defaults.
MDOPS_DEFAULT_LABELS=markdownops

# Required: Notion integration token. Create at:
#   https://www.notion.so/my-integrations
# Then share the target database with the integration.
NOTION_API_KEY=

# Required: Notion database ID (UUID). The database must have these properties:
#   - "Name"      (type: title)
#   - "Tags"      (type: multi_select)
#   - "Assignees" (type: people)
MDOPS_NOTION_DATABASE=

# Optional: comma-separated tags added to every page created by mdops_create_issue.
# Default "markdownops".
MDOPS_DEFAULT_LABELS=markdownops

# Optional: base URL where Markdown artifacts live, used by mdops_link_artifact.
MDOPS_NOTION_ARTIFACT_BASE=

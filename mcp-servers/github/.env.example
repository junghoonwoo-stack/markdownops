# Required: a personal access token (classic or fine-grained) with at least
# "repo" scope (for private repos) or "public_repo" scope (for public repos),
# plus "issues: read & write" for fine-grained tokens.
GITHUB_TOKEN=

# Required: the repo this MCP server operates on, in "owner/repo" form.
MDOPS_GITHUB_REPO=

# Optional: default labels added to every issue created by mdops_create_issue.
# Comma-separated. Leave empty to add no defaults.
MDOPS_DEFAULT_LABELS=markdownops

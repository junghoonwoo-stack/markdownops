# Required: Atlassian account email used with the API token below.
JIRA_EMAIL=

# Required: Jira API token. Create at:
#   https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Required: Jira Cloud host, including https://. Example:
#   https://yourcompany.atlassian.net
MDOPS_JIRA_HOST=

# Required: Project key (the prefix in issue keys, e.g. "PROJ" for PROJ-123).
MDOPS_JIRA_PROJECT=

# Optional: Issue type to use when creating issues. Defaults to "Task".
MDOPS_JIRA_ISSUE_TYPE=Task

# Optional: comma-separated labels added to every issue created by
# mdops_create_issue. Defaults to "markdownops".
MDOPS_DEFAULT_LABELS=markdownops

# Optional: base URL where Markdown artifacts live, used by mdops_link_artifact.
# If set, links are constructed as <base>/<artifact_path>. Example:
#   https://github.com/owner/repo/blob/main
MDOPS_JIRA_ARTIFACT_BASE=

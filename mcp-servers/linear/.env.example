# Required: Linear personal API key. Create at:
#   https://linear.app/settings/api/personal
LINEAR_API_KEY=

# Required: Linear team. Either:
#   - Team key (e.g. "ENG", "PROD")
#   - Team UUID
MDOPS_LINEAR_TEAM=

# Optional: comma-separated labels added to every issue created by mdops_create_issue.
# Defaults to "markdownops". Labels are auto-created in the team if missing.
MDOPS_DEFAULT_LABELS=markdownops

# Optional: base URL where Markdown artifacts live, used by mdops_link_artifact.
# Example:  https://github.com/owner/repo/blob/main
MDOPS_LINEAR_ARTIFACT_BASE=
